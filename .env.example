# AgentFlow 环境变量示例：复制为 .env 后填写
# 数据库
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow
CHECKPOINT_DB_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow

# 开发回退：Docker/Postgres 不可用时设为 true（SQLite + 内存检查点）
DEV_SQLITE=false

# LLM（至少填一个）
OPENAI_API_KEY=
# 可选：兼容 OpenAI 协议的本地/第三方服务（如阿里百炼 https://dashscope.aliyuncs.com/compatible-mode/v1）
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# DeepSeek：模型名以 deepseek 开头时自动使用（base url 内置）
DEEPSEEK_API_KEY=

# 默认模型（init_chat_model 标识）
DEFAULT_MODEL=deepseek-chat

# MCP filesystem Server 允许访问的目录（相对 server/ 的路径）
MCP_FILESYSTEM_DIR=../workspace

# Agent 循环上限
MAX_ITERATIONS=8

# 可观测性（Harness Phase 2）：OTel tracing
OTEL_ENABLED=true
# 留空则不导出到 Jaeger（仅内存缓冲 + 控制台兜底）；本地 Jaeger OTLP HTTP 端点示例：
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentflow
# 调试用：把 span 打到控制台
OTEL_CONSOLE_EXPORT=false

# 策略（Harness Phase 2）：重试与模型降级
POLICY_MAX_ATTEMPTS=3
POLICY_BACKOFF_MIN_SEC=1.0
POLICY_BACKOFF_MAX_SEC=8.0
