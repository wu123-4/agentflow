# AgentFlow 环境变量示例：复制为 .env 后填写
# 数据库
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow
CHECKPOINT_DB_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow

# 开发回退：Docker/Postgres 不可用时设为 true（SQLite + 内存检查点）
DEV_SQLITE=false

# 开发回退：无 API Key 时设为 true，用假模型跑通 SSE/工具/HITL/门控全链路（仅开发用）
DEV_FAKE_MODEL=false

# LLM（至少填一个）
OPENAI_API_KEY=
# 可选：兼容 OpenAI 协议的本地/第三方服务（如阿里百炼 https://dashscope.aliyuncs.com/compatible-mode/v1）
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# DeepSeek：模型名以 deepseek 开头时自动使用（base url 内置）
DEEPSEEK_API_KEY=

# 默认模型（init_chat_model 标识）
DEFAULT_MODEL=deepseek-chat

# MCP filesystem Server 允许访问的目录（相对 server/ 的路径）
MCP_FILESYSTEM_DIR=../workspace

# Agent 循环上限
MAX_ITERATIONS=8

# 可观测性（Harness Phase 2）：OTel tracing
OTEL_ENABLED=true
# 留空则不导出到 Jaeger（仅内存缓冲 + 控制台兜底）；本地 Jaeger OTLP HTTP 端点示例：
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentflow
# 调试用：把 span 打到控制台
OTEL_CONSOLE_EXPORT=false

# 策略（Harness Phase 2）：重试与模型降级
POLICY_MAX_ATTEMPTS=3
POLICY_BACKOFF_MIN_SEC=1.0
POLICY_BACKOFF_MAX_SEC=8.0

# 恢复（Harness Phase 3）：工具层分级恢复
RECOVERY_MAX_ATTEMPTS=2
RECOVERY_BACKOFF_MIN_SEC=0.2
RECOVERY_BACKOFF_MAX_SEC=2.0
# 命中任一子串即视为写操作（需副作用对账）；JSON 数组格式
WRITE_TOOL_PATTERNS=["write", "create", "delete", "send"]

# 循环检测（Harness Phase 3）：同一 tool+args 连续重复阈值，达到即终止
LOOP_DETECT_THRESHOLD=3

# 上下文治理（Harness Phase 3）
CONTEXT_COMPACT_RATIO=0.7        # 估算 token 占模型 context_window 的比例阈值
CONTEXT_MAX_MESSAGES=40          # 消息条数阈值
CONTEXT_KEEP_RECENT=6            # 治理后保留的最近消息条数
CONTEXT_STRATEGY=compaction      # compaction | reset | auto
CONTEXT_STATE_PATH=context_state.md

# 长期记忆（Harness Phase 4）：Postgres 用 pgvector，dev 模式降级为伪向量
MEMORY_ENABLED=true
MEMORY_TOP_K=3
# 留空 -> 确定性哈希伪向量（无需外部 embedding 服务）
EMBEDDING_MODEL=

# 其他
# HITL 确认超时（秒）：超时由巡检任务注入"默认拒绝"
APPROVAL_TIMEOUT_SEC=600
# 启动时自动建表（生产建议 false，改用 alembic upgrade head）
AUTO_CREATE_TABLES=true
